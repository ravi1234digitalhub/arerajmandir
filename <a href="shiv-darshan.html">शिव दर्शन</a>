<div class="shiv-modal" id="shivContactModal" role="dialog" aria-modal="true" aria-labelledby="shivContactTitle">
 <div class="shiv-modal-box">
  <button type="button" class="shiv-modal-close" onclick="closeShivContact()" aria-label="बंद करें">×</button>
  <h2 id="shivContactTitle">🔱 शिव दर्शन / पूजा के लिए संपर्क</h2>
  <p><strong>श्री सोमेश्वर नाथ महादेव, अरेराज धाम</strong></p>
  <form onsubmit="sendShivContact(event)">
   <label for="shivPanda">पंडा चुनें</label><select id="shivPanda" required><option value="पंडा बिंदा गिरि जी" selected>पंडा बिंदा गिरि जी</option></select>
   <label for="shivName">भक्त का नाम</label><input id="shivName" required placeholder="अपना नाम" autocomplete="name">
   <label for="shivMobile">मोबाइल नंबर</label><input id="shivMobile" required type="tel" inputmode="tel" placeholder="मोबाइल नंबर" autocomplete="tel">
   <label for="shivAddress">पता</label><textarea id="shivAddress" required rows="2" placeholder="गाँव / शहर, जिला, राज्य"></textarea>
   <label for="shivDate">पूजा / दर्शन की तारीख</label><input id="shivDate" required type="date">
   <label for="shivMessage">विशेष संदेश</label><textarea id="shivMessage" rows="3" placeholder="अपनी आवश्यकता लिखें"></textarea>
   <button class="shiv-modal-submit" type="submit">📱 WhatsApp पर संदेश भेजें</button>
  </form>
 </div>
</div>
<script>
function openShivContact(){document.getElementById('shivContactModal').style.display='block';document.body.style.overflow='hidden'}
function closeShivContact(){document.getElementById('shivContactModal').style.display='none';document.body.style.overflow=''}
document.getElementById('shivContactModal').addEventListener('click',function(e){if(e.target===this)closeShivContact()});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeShivContact()});
function sendShivContact(e){e.preventDefault();const panda=document.getElementById('shivPanda').value;const name=document.getElementById('shivName').value.trim();const mobile=document.getElementById('shivMobile').value.trim();const address=document.getElementById('shivAddress').value.trim();const date=document.getElementById('shivDate').value;const message=document.getElementById('shivMessage').value.trim();const body='🔱 अरेराज धाम — शिव दर्शन / पूजा संबंधी संपर्क\n\nभक्त का नाम: '+name+'\nमोबाइल नंबर: '+mobile+'\nपता: '+address+'\nचुने गए पंडा जी: '+panda+'\nसेवा: शिव दर्शन / पूजा संबंधी जानकारी\nतारीख: '+date+'\nविशेष संदेश: '+(message||'कोई नहीं');window.open('https://wa.me/917033066081?text='+encodeURIComponent(body),'_blank','noopener')}
</script>

